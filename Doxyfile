# Doxygen configuration for taskjuggler-lsp.
#
# Only non-default options are set here; everything else uses Doxygen's
# built-in defaults. Run `make docs` to generate HTML output under docs/.

PROJECT_NAME           = "taskjuggler-lsp"
PROJECT_NUMBER         = 0.5.3
PROJECT_BRIEF          = "Language Server Protocol implementation for TaskJuggler v3"

OUTPUT_DIRECTORY       = doc/_doxygen
INPUT                  = src README.md
FILE_PATTERNS          = *.c *.h
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md

# Skip flex/bison output — generated, and Doxygen chokes on the macros.
EXCLUDE                = src/lexer.yy.c src/grammar.tab.c src/grammar.tab.h

# Function-body-local helper macros.  Doxygen extracts them because they
# are #defines, but they aren't real members of the file's API surface and
# can't be cleanly associated with their preceding comment.
EXCLUDE_SYMBOLS        = SIG SIG0

# Strip C11 _Atomic qualifiers before Doxygen ever sees them.  Doxygen
# handles the keyword internally but propagates it verbatim into its
# XML output, and Breathe's Sphinx C-domain parser then rejects the
# resulting declarations.  See doc/strip_atomic.sh.
INPUT_FILTER           = "doc/strip_atomic.sh"

EXTRACT_ALL            = NO
# Internal static helpers in *.c files are deliberately not exposed in the
# published API reference; their behaviour is documented inline at the call
# site.  This keeps the reference focused on the public header surface.
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

# Clickable source browser plus textual "calls" / "called by" lists on
# every function page, complementing the dot graphs below.
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

# XML output is consumed by Breathe to render API documentation
# into the Sphinx site published on Read the Docs.
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

QUIET                  = YES
# Several structs document their fields with descriptive prose at the type
# level rather than with per-member /**< ... */ comments; rely on that
# instead of requiring a comment on every member.  Doc-syntax errors and
# broken cross-references still warn.
WARN_IF_UNDOCUMENTED   = NO
# Many function descriptions cover their parameters inline in the
# description block rather than via @param tags; suppress the per-parameter
# nag so genuine documentation problems stay visible.
WARN_NO_PARAMDOC       = NO
# Promote any remaining warning to a build failure so regressions in the
# documentation can't sneak past CI.
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# Requires graphviz to be installed (provides the `dot` binary).
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100
