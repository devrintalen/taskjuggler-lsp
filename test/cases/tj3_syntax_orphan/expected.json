[
  {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "capabilities": {
        "textDocumentSync": {
          "change": 2,
          "openClose": true
        },
        "documentSymbolProvider": true,
        "foldingRangeProvider": true,
        "codeLensProvider": {
          "resolveProvider": false
        },
        "hoverProvider": true,
        "definitionProvider": true,
        "referencesProvider": true,
        "documentHighlightProvider": true,
        "signatureHelpProvider": {
          "triggerCharacters": [
            " "
          ]
        },
        "completionProvider": {
          "triggerCharacters": [
            "!",
            "."
          ],
          "resolveProvider": false
        },
        "semanticTokensProvider": {
          "legend": {
            "tokenTypes": [
              "keyword",
              "comment",
              "string",
              "number",
              "variable",
              "function"
            ],
            "tokenModifiers": [
              "declaration"
            ]
          },
          "full": {
            "delta": true
          }
        },
        "workspaceSymbolProvider": true,
        "workspace": {
          "workspaceFolders": {
            "supported": false
          },
          "fileOperations": {
            "didRename": {
              "filters": [
                {
                  "pattern": {
                    "glob": "**/*.tjp"
                  }
                },
                {
                  "pattern": {
                    "glob": "**/*.tji"
                  }
                }
              ]
            }
          }
        }
      },
      "serverInfo": {
        "name": "taskjuggler-lsp",
        "version": "0.5.3"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": "watcher-reg",
    "method": "client/registerCapability",
    "params": {
      "registrations": [
        {
          "id": "file-watcher",
          "method": "workspace/didChangeWatchedFiles",
          "registerOptions": {
            "watchers": [
              {
                "globPattern": "**/*.tjp"
              },
              {
                "globPattern": "**/*.tji"
              }
            ]
          }
        }
      ]
    }
  },
  {
    "jsonrpc": "2.0",
    "method": "textDocument/publishDiagnostics",
    "params": {
      "uri": "file://${CASE_DIR}/orphan.tjp",
      "diagnostics": []
    }
  },
  {
    "jsonrpc": "2.0",
    "method": "textDocument/publishDiagnostics",
    "params": {
      "uri": "file://${CASE_DIR}/orphan.tjp",
      "diagnostics": [
        {
          "range": {
            "start": {
              "line": 3,
              "character": 0
            },
            "end": {
              "line": 3,
              "character": 2147483647
            }
          },
          "severity": 1,
          "source": "tj3",
          "message": "Unexpected token 'boguskeyword' found. Expecting one of 'adopt', 'journalentry', 'note', 'purge', 'supplement', 'task', 'account', 'allocate', 'booking', 'charge', 'chargeset', 'complete', 'depends', 'duration', 'effort', 'effortdone', 'effortleft', 'end', 'endcredit', 'flags', 'fail', 'length', 'limits', 'maxend', 'maxstart', 'milestone', 'minend', 'minstart', 'startcredit', 'period', 'precedes', 'priority', 'projectid', 'responsible', 'scheduled', 'scheduling', 'schedulingmode', 'shift', 'shifts', 'start', 'warn', :ID_WITH_COLON, '}'"
        }
      ]
    }
  }
]
