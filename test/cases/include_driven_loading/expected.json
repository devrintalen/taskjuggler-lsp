        },
        "completionProvider": {
          "triggerCharacters": [
            "!",
            "."
          ],
          "resolveProvider": false
        },
        "semanticTokensProvider": {
          "legend": {
            "tokenTypes": [
              "keyword",
              "comment",
              "string",
              "number",
              "variable",
              "function"
