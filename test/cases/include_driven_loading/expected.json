            "tokenModifiers": [
              "declaration"
            ]
          },
          "full": {
            "delta": true
          }
        },
        "workspaceSymbolProvider": true,
        "workspace": {
          "fileOperations": {
            "didRename": {
              "filters": [
                {
                  "pattern": {
                    "glob": "**/*.tjp"
                  }
                },
                {
                  "pattern": {
                    "glob": "**/*.tji"
                  }
                }
              ]
            }
          }
        }
      },
      "serverInfo": {
        "name": "taskjuggler-lsp",
        "version": "0.5.3"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": "watcher-reg",
    "method": "client/registerCapability",
    "params": {
      "registrations": [
        {
          "id": "file-watcher",
          "method": "workspace/didChangeWatchedFiles",
          "registerOptions": {
            "watchers": [
              {
                "globPattern": "**/*.tjp"
              },
              {
                "globPattern": "**/*.tji"
              }
            ]
          }
        }
      ]
    }
  },
