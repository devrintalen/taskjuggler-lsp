[
  {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "capabilities": {
        "textDocumentSync": {
          "change": 2,
          "openClose": true
        },
        "documentSymbolProvider": true,
        "foldingRangeProvider": true,
        "codeLensProvider": {
          "resolveProvider": false
        },
        "hoverProvider": true,
        "definitionProvider": true,
        "referencesProvider": true,
        "documentHighlightProvider": true,
        "signatureHelpProvider": {
          "triggerCharacters": [
            " "
          ]
        },
        "completionProvider": {
          "triggerCharacters": [
            "!",
            "."
          ],
          "resolveProvider": false
        },
        "semanticTokensProvider": {
          "legend": {
            "tokenTypes": [
              "keyword",
              "comment",
              "string",
              "number",
              "variable",
              "function"
            ],
            "tokenModifiers": [
              "declaration"
            ]
          },
          "full": {
            "delta": true
          }
        },
        "workspaceSymbolProvider": true,
        "workspace": {
          "fileOperations": {
            "didRename": {
              "filters": [
                {
                  "pattern": {
                    "glob": "**/*.tjp"
                  }
                },
                {
                  "pattern": {
                    "glob": "**/*.tji"
                  }
                }
              ]
            }
          }
        }
      },
      "serverInfo": {
        "name": "taskjuggler-lsp",
        "version": "0.5.3"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": "watcher-reg",
    "method": "client/registerCapability",
    "params": {
      "registrations": [
        {
          "id": "file-watcher",
          "method": "workspace/didChangeWatchedFiles",
          "registerOptions": {
            "watchers": [
              {
                "globPattern": "**/*.tjp"
              },
              {
                "globPattern": "**/*.tji"
              }
            ]
          }
        }
      ]
    }
  },
