.env
# Ignore personal Claude Code state, but keep the shared SessionStart hook and
# its settings so web sessions install dependencies automatically.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
*~
__pycache__/
*.pyc
/src/*.o
/src/*.d
/taskjuggler-lsp
/taskjuggler-lsp-debug
/src/lexer.yy.c
/src/grammar.tab.c
/src/grammar.tab.h
/lexer-test
/grammar-test
/test/large_*.tjp
/doc/_build/
/doc/_doxygen/
doxygen.warnings.log
